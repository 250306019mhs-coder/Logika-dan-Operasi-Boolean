# Cara membuat himpunan pada python
A = {1,2,3,4}
B = {3,4,5,6}
print (A U B =", A | B) # Union (gabungan)
print (A n B =", A & B) # Intersection (irisan)
print (A - B =", A - B) # Difference (hasil himpunan A saja)
print (B U A =", A - B) # Difference (hasil himpunan B saja)
print (A O B =", A ^ B) # Symmetric Difference 
